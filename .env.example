MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=tender-pdfs
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT Authentication
# 256-bit hex secret key for HS256 HMAC
JWT_SECRET=9a6747f3b6c4349479b009eb733a1cc00142b6045610816a7f8ca9b2520bb262
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Backend Services
